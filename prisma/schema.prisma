// AutoMind — Prisma schema
//
// Phase 1 scope ONLY: authentication tables plus a minimal Vehicle record used
// to prove that a real domain table round-trips against MySQL.
//
// The full vehicle domain (VehicleIdentification, VehicleConfiguration,
// VehicleModule) is Stage 3 and is deliberately NOT modelled here yet.

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

// Prisma 7: the connection URL lives in prisma.config.ts (for the CLI) and is
// supplied to PrismaClient through a driver adapter (for the runtime).
datasource db {
  provider = "mysql"
}

// ---------------------------------------------------------------------------
// Authentication (Auth.js v5 + @auth/prisma-adapter)
// ---------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  // Null for OAuth-only accounts. Never stores a plaintext password.
  passwordHash  String?   @db.VarChar(255)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts Account[]
  sessions Session[]
  vehicles Vehicle[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ---------------------------------------------------------------------------
// Vehicle domain (Stage 3)
//
// Every descriptive field is nullable and NULL always means "not known". A
// missing value is never backfilled with a plausible default (Rule 1).
//
// These enums mirror src/domain/vehicles/types.ts exactly. The domain owns the
// vocabulary; this schema persists it.
// ---------------------------------------------------------------------------

enum FuelType {
  PETROL
  DIESEL
  HYBRID_PETROL
  HYBRID_DIESEL
  PLUG_IN_HYBRID
  ELECTRIC
  LPG
  CNG
  OTHER
}

enum TransmissionType {
  MANUAL
  AUTOMATIC
  CVT
  DUAL_CLUTCH
  AUTOMATED_MANUAL
  REDUCTION_GEAR
  OTHER
}

enum DriveType {
  FWD
  RWD
  AWD
  FOUR_WD
}

enum ObdProtocol {
  SAE_J1850_PWM
  SAE_J1850_VPW
  ISO_9141_2
  ISO_14230_4_KWP_5BAUD
  ISO_14230_4_KWP_FAST
  ISO_15765_4_CAN_11B_500K
  ISO_15765_4_CAN_29B_500K
  ISO_15765_4_CAN_11B_250K
  ISO_15765_4_CAN_29B_250K
  SAE_J1939_CAN
  UNKNOWN
}

enum ModuleSystem {
  ENGINE
  TRANSMISSION
  ABS
  SRS
  BODY
  CLIMATE
  INSTRUMENT_CLUSTER
  STEERING
  IMMOBILISER
  HYBRID_BATTERY
  OTHER
}

enum ModuleStatus {
  DETECTED
  NOT_RESPONDING
  NOT_SUPPORTED
  ERROR
  UNKNOWN
}

enum IdentificationSource {
  USER_ENTERED
  VIN_DECODED
  OBD_REPORTED
  UNKNOWN
}

enum IdentificationStatus {
  UNIDENTIFIED
  PARTIALLY_IDENTIFIED
  IDENTIFIED
  CONFLICTED
}

model Vehicle {
  id      String @id @default(cuid())
  ownerId String

  /// Optional nickname, e.g. "The white one".
  displayName String? @db.VarChar(80)

  make  String? @db.VarChar(64)
  model String? @db.VarChar(64)
  year  Int?    @db.SmallInt

  /// Normalised (uppercase, separators stripped) by the service layer.
  vin String? @db.VarChar(17)

  isPrimary Boolean   @default(false)
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner          User                   @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  identification VehicleIdentification?
  configuration  VehicleConfiguration?
  modules        VehicleModule[]
  scanSessions   ScanSession[]
  events         VehicleEvent[]
  maintenance    MaintenanceRecord[]
  aiInteractions AiInteraction[]
  repairs        RepairEvent[]
  quotes         RepairQuote[]

  /// Scoped to the owner rather than globally: the same physical vehicle can
  /// legitimately be registered by a new owner after a sale. MySQL permits
  /// repeated NULLs, so vehicles without a VIN do not collide.
  @@unique([ownerId, vin])
  @@index([ownerId])
  @@index([ownerId, deletedAt])
  @@map("vehicles")
}

/// A derived snapshot, recomputed from the vehicle's facts by
/// src/domain/vehicles/identification.ts on every write. Persisted so it can
/// be queried and sorted; the domain function remains the source of truth.
/// Contributions and gaps are deliberately NOT stored — they are recomputed,
/// so they can never go stale against the facts.
model VehicleIdentification {
  id        String @id @default(cuid())
  vehicleId String @unique

  status     IdentificationStatus @default(UNIDENTIFIED)
  /// 0–100.
  confidence Int                  @default(0)
  source     IdentificationSource @default(UNKNOWN)

  /// NULL when no VIN is recorded, so the question was never asked.
  vinStructurallyValid Boolean?
  /// NULL when it could not be evaluated. FALSE is informative, not
  /// disqualifying: the check digit is not part of ISO 3779 outside North
  /// America (see src/domain/vehicles/vin.ts).
  vinCheckDigitValid   Boolean?

  /// Set when two sources disagree about the same vehicle.
  hasConflict Boolean @default(false)

  assessedAt DateTime @default(now())
  updatedAt  DateTime @updatedAt

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([status])
  @@map("vehicle_identifications")
}

model VehicleConfiguration {
  id        String @id @default(cuid())
  vehicleId String @unique

  engineCode           String? @db.VarChar(32)
  engineDisplacementCc Int?    @db.SmallInt
  engineCylinders      Int?    @db.TinyInt

  fuelType          FuelType?
  transmissionType  TransmissionType?
  transmissionGears Int?              @db.TinyInt
  driveType         DriveType?

  ecuName      String?      @db.VarChar(64)
  obdProtocol  ObdProtocol?
  /// NULL means we have not established whether the vehicle speaks OBD-II.
  supportsObd2 Boolean?

  source IdentificationSource @default(UNKNOWN)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@map("vehicle_configurations")
}

model VehicleModule {
  id        String @id @default(cuid())
  vehicleId String

  name    String       @db.VarChar(64)
  system  ModuleSystem @default(OTHER)
  /// ECU address exactly as reported, e.g. "7E0".
  address String?      @db.VarChar(8)

  protocol ObdProtocol?
  status   ModuleStatus @default(UNKNOWN)

  discoveredAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  /// One record per address per vehicle.
  @@unique([vehicleId, address])
  @@index([vehicleId])
  @@index([vehicleId, system])
  @@map("vehicle_modules")
}

// ---------------------------------------------------------------------------
// Vehicle memory (Stage 15)
//
// The vehicle stops being a VIN record and becomes a long-term data object:
// every scan, finding, ranked cause, confirmation test and AI interaction is
// kept against it.
//
// Two decisions shape these tables.
//
// 1. **Statistics are stored, not raw sample buffers.** A scan holds roughly
//    900 points across eighteen parameters; keeping every one would be tens of
//    thousands of rows per session for data nothing reads back. What the
//    analysis actually consumes — and what a trend over months needs — is the
//    per-condition summary, so that is what is persisted. The raw buffer is a
//    live-view artefact and is allowed to die with the page.
//
// 2. **A diagnosis is stored as it was reached, not recomputed on read.** The
//    engine is deterministic, so re-running it would usually give the same
//    answer — but only against the same catalogue. When a cause is added in a
//    later release, a stored diagnosis must still say what the user was
//    actually told at the time. Nothing here is regenerated.
// ---------------------------------------------------------------------------

enum DtcStatus {
  STORED
  PENDING
  PERMANENT
}

enum FindingSeverity {
  INFO
  ADVISORY
  SIGNIFICANT
  SEVERE
}

enum VehicleSystem {
  FUEL
  AIR
  IGNITION
  COOLING
  ELECTRICAL
  TRANSMISSION
  EMISSIONS
  UNKNOWN
}

enum DifferentialVerdict {
  SINGLE_LEADING
  AMBIGUOUS
  INSUFFICIENT
}

enum CauseStatus {
  SUPPORTED
  POSSIBLE
  RULED_OUT
}

enum TestOutcome {
  PASS
  FAIL
  NORMAL
  ABNORMAL
  UNABLE_TO_PERFORM
  SKIP
}

enum AiInteractionKind {
  EXPLANATION
  CONVERSATION
}

/// One recorded scan.
model ScanSession {
  id        String @id @default(cuid())
  vehicleId String

  /// Copied from the provider descriptor at the time of the scan. Kept on the
  /// row rather than looked up later, because which adapter produced a reading
  /// is part of what the reading means — and Rule 2 depends on it surviving.
  providerName String  @db.VarChar(64)
  isSimulated  Boolean
  /// The simulated fault, when there was one. NULL for a real vehicle.
  scenario     String? @db.VarChar(48)

  startedAt DateTime
  endedAt   DateTime?

  sampleCount Int @default(0)
  durationMs  Int @default(0)

  /// Operating conditions the scan actually covered, e.g. ["IDLE","LIGHT_LOAD"].
  /// What a scan did NOT cover is what limits a diagnosis, so it is recorded.
  conditionsObserved Json

  createdAt DateTime @default(now())

  vehicle       Vehicle         @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  dtcs          SessionDtc[]
  parameters    ParameterStat[]
  diagnosis     Diagnosis?
  events        VehicleEvent[]
  repairsBefore RepairEvent[]   @relation("BeforeScan")
  repairsAfter  RepairEvent[]   @relation("AfterScan")

  @@index([vehicleId, startedAt])
  @@map("scan_sessions")
}

/// A fault code as reported during a scan. Structure only — this build has no
/// authoritative table of meanings, so none is stored (Rule 1).
model SessionDtc {
  id        String @id @default(cuid())
  sessionId String

  code          String    @db.VarChar(8)
  status        DtcStatus @default(STORED)
  /// The module that reported it, exactly as given.
  moduleAddress String?   @db.VarChar(8)

  firstSeenAt DateTime

  session ScanSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, code])
  @@index([sessionId])
  @@map("session_dtcs")
}

/// Per-parameter, per-condition summary for one scan.
///
/// This is the trend spine: a battery declining across three sessions is this
/// table read over time, which is what Stage 21 will do.
model ParameterStat {
  id        String @id @default(cuid())
  sessionId String

  parameterId String @db.VarChar(48)
  /// IDLE, LIGHT_LOAD, CRUISE, HIGH_LOAD, DECELERATION, CRANKING, UNKNOWN.
  condition   String @db.VarChar(24)

  samples Int
  mean    Float
  min     Float
  max     Float
  unit    String? @db.VarChar(16)

  session ScanSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, parameterId, condition])
  @@index([sessionId])
  @@index([parameterId])
  @@map("parameter_stats")
}

/// The diagnosis reached from a scan, exactly as it was reached.
model Diagnosis {
  id        String @id @default(cuid())
  sessionId String @unique

  verdict DifferentialVerdict

  /// What could not be established, in the engine's own words. Stored because
  /// a diagnosis without its limits reads as more certain than it was.
  limitations Json

  createdAt DateTime @default(now())

  session  ScanSession           @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  findings DiagnosisFinding[]
  causes   DiagnosisCause[]
  tests    ConfirmationTestRun[]

  @@map("diagnoses")
}

model DiagnosisFinding {
  id          String @id @default(cuid())
  diagnosisId String

  /// The engine's stable id, e.g. "lean-condition".
  findingId String          @db.VarChar(64)
  title     String          @db.VarChar(160)
  system    VehicleSystem   @default(UNKNOWN)
  severity  FindingSeverity @default(INFO)

  /// Observations for and against, each with its measured values.
  supporting Json
  opposing   Json

  diagnosis Diagnosis @relation(fields: [diagnosisId], references: [id], onDelete: Cascade)

  @@index([diagnosisId])
  @@map("diagnosis_findings")
}

model DiagnosisCause {
  id          String @id @default(cuid())
  diagnosisId String

  /// The catalogue id, e.g. "unmetered-air".
  causeId   String        @db.VarChar(64)
  label     String        @db.VarChar(160)
  system    VehicleSystem @default(UNKNOWN)
  mechanism String        @db.Text

  status             CauseStatus
  /// 0–100. A fit against the evidence, never a probability.
  confidence         Int
  /// The raw sum behind the percentage, kept so it stays auditable.
  pointsEarned       Int
  pointsAvailable    Int
  keyObservationMade Boolean     @default(false)

  /// Every point with the observation that awarded it and the reason, and
  /// every exclusion with what ruled the cause out.
  contributions Json
  exclusions    Json

  diagnosis Diagnosis @relation(fields: [diagnosisId], references: [id], onDelete: Cascade)

  @@index([diagnosisId])
  @@index([causeId])
  @@map("diagnosis_causes")
}

/// A confirmation test as performed, including the ones that settled nothing.
model ConfirmationTestRun {
  id          String @id @default(cuid())
  diagnosisId String

  testId  String      @db.VarChar(64)
  outcome TestOutcome
  /// What the performer actually measured, in their own words.
  note    String?     @db.VarChar(500)

  recordedAt DateTime @default(now())

  diagnosis Diagnosis @relation(fields: [diagnosisId], references: [id], onDelete: Cascade)

  @@index([diagnosisId])
  @@map("confirmation_test_runs")
}

/// Owner-entered maintenance. The one kind of history a user can supply
/// directly, and the only history this build has that predates its own scans.
model MaintenanceRecord {
  id        String @id @default(cuid())
  vehicleId String

  performedAt DateTime
  title       String   @db.VarChar(120)
  notes       String?  @db.VarChar(1000)
  /// As recorded by the owner. NULL means not known — never estimated.
  odometerKm  Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  vehicle Vehicle        @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  events  VehicleEvent[]

  @@index([vehicleId, performedAt])
  @@map("maintenance_records")
}

/// An AI interaction, kept so an explanation can be traced to what produced it.
///
/// The context is stored alongside the output deliberately: "what was the
/// model actually told?" has to be answerable after the fact, and it is the
/// only way to re-run the grounding check on a past answer.
model AiInteraction {
  id        String @id @default(cuid())
  vehicleId String

  kind  AiInteractionKind
  model String            @db.VarChar(64)

  context String  @db.Text
  /// The reply, or NULL when it was withheld.
  output  String? @db.Text

  /// False when the grounding check rejected it. A withheld answer is part of
  /// the record: it says the model produced something and it was refused.
  grounded   Boolean @default(true)
  violations Json?

  createdAt DateTime @default(now())

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId, createdAt])
  @@map("ai_interactions")
}

/// A repair, and the two scans that bracket it.
///
/// The before scan is required: a repair with nothing recorded beforehand
/// cannot be verified against anything, and storing one would put an
/// unverifiable claim on the timeline. The after scan arrives later, which is
/// why it is nullable.
///
/// `summary` is what the owner says was done. This build does not verify it,
/// and the verification output says so.
model RepairEvent {
  id        String @id @default(cuid())
  vehicleId String

  performedAt DateTime
  summary     String   @db.VarChar(160)
  notes       String?  @db.VarChar(1000)

  /// The guide followed and the cause it addressed, when a guide was used.
  guideId String? @db.VarChar(64)
  causeId String? @db.VarChar(64)

  beforeSessionId String
  afterSessionId  String?

  /// The conclusion reached, stored as it was reached. Null until an after
  /// scan exists. Never recomputed on read, for the same reason a diagnosis
  /// is not: the thresholds it was judged against may change.
  verdict    VerificationVerdict?
  verifiedAt DateTime?
  /// The full comparison, so the conclusion can be walked back to its numbers.
  comparison Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  vehicle       Vehicle        @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  beforeSession ScanSession    @relation("BeforeScan", fields: [beforeSessionId], references: [id], onDelete: Cascade)
  afterSession  ScanSession?   @relation("AfterScan", fields: [afterSessionId], references: [id], onDelete: SetNull)
  events        VehicleEvent[]

  @@index([vehicleId, performedAt])
  @@index([beforeSessionId])
  @@index([afterSessionId])
  @@map("repair_events")
}

enum QuoteSource {
  MECHANIC
  OWNER
  SUPPLIER
}

/// A figure the owner was actually given.
///
/// Distinct from an estimate: this build cannot produce an estimate, because
/// it has no parts catalogue, labour rates or market data. What it can do is
/// record what someone was quoted, which is real data supplied by the person
/// it concerns.
///
/// Money is stored as integer minor units. Floating point is wrong for money,
/// and a rounding error in a repair quote is the kind of bug that survives to
/// production because it looks like someone else's mistake.
model RepairQuote {
  id        String @id @default(cuid())
  vehicleId String

  source      QuoteSource
  /// Who gave it. This build does not verify the business exists.
  providedBy  String      @db.VarChar(120)
  /// What the quote covers, in their words. Required: two quotes are only
  /// comparable if it is clear what each covers, and that is the user's call.
  description String      @db.VarChar(300)

  /// Integer minor units, e.g. cents. Never a float.
  totalMinor Int
  /// ISO 4217. Never assumed.
  currency   String @db.VarChar(3)

  /// Only when the quote itself gave a split. Never inferred.
  partsMinor  Int?
  labourMinor Int?

  receivedAt DateTime
  notes      String?  @db.VarChar(1000)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId, receivedAt])
  @@map("repair_quotes")
}

// ---------------------------------------------------------------------------
// The timeline spine (Stage 17 reads this)
// ---------------------------------------------------------------------------

enum VehicleEventKind {
  SCAN_RECORDED
  DTC_OBSERVED
  FINDING_RAISED
  DIAGNOSIS_REACHED
  TEST_PERFORMED
  MAINTENANCE_LOGGED
  REPAIR_RECORDED
  VERIFICATION_COMPLETED
}

enum VerificationVerdict {
  CONSISTENT_WITH_REPAIR
  NOT_DEMONSTRATED
  WORSENED
  INCONCLUSIVE
}

/// One dated thing that happened to a vehicle.
///
/// Denormalised on purpose. A timeline has to merge scans, findings, tests and
/// maintenance in date order, and doing that across five tables at read time
/// would be a union query that grows with every future stage. Events are
/// written once, in the same transaction as the records they describe, so they
/// cannot drift from them.
model VehicleEvent {
  id        String @id @default(cuid())
  vehicleId String

  kind       VehicleEventKind
  /// When it actually happened, which is not always when it was recorded.
  occurredAt DateTime

  title    String           @db.VarChar(160)
  detail   String?          @db.VarChar(1000)
  /// NULL where severity does not apply, e.g. maintenance.
  severity FindingSeverity?
  system   VehicleSystem?

  sessionId     String?
  maintenanceId String?
  repairId      String?

  createdAt DateTime @default(now())

  vehicle     Vehicle            @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  session     ScanSession?       @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  maintenance MaintenanceRecord? @relation(fields: [maintenanceId], references: [id], onDelete: Cascade)
  repair      RepairEvent?       @relation(fields: [repairId], references: [id], onDelete: Cascade)

  @@index([vehicleId, occurredAt])
  @@index([sessionId])
  @@index([maintenanceId])
  @@index([repairId])
  @@map("vehicle_events")
}
