# ---------------------------------------------------------------------------
# AutoMind — environment configuration template
#
# Copy to .env.local and fill in real values. .env.local is gitignored and MUST
# NOT be committed.
#
# Everything below the "Required" block is optional. The product is complete
# without any of it: each optional feature reports that it is unconfigured
# rather than substituting a fallback nobody was told about.
# ---------------------------------------------------------------------------

# --- Required ---------------------------------------------------------------

# MySQL connection string.
#   mysql://USER:PASSWORD@HOST:PORT/DATABASE
#
# Special characters in the password must be percent-encoded
# (@ -> %40, # -> %23, : -> %3A, / -> %2F).
DATABASE_URL="mysql://user:password@127.0.0.1:3306/automind"

# Auth.js v5 secret. Generate with: npx auth secret
AUTH_SECRET=""

# Canonical URL of the application.
#
# Auth.js redirects to THIS address, not to the one the request arrived on. If
# you run the app on another port, change this too — otherwise sign-in succeeds
# and then lands on a dead host, which reads as a broken login.
AUTH_URL="http://localhost:3000"

# Password for the admin account created by `npm run db:seed`.
#
# There is no default: a seeded password nobody chose is one nobody changes.
# Re-running the seed resets it, so it is a reliable way back in.
ADMIN_PASSWORD=""

# --- AI: diagnosis explanations, the mechanic chat, and vehicle recognition --

# One key serves all three — same account, same bill.
#
# Without it: the diagnosis is complete and unchanged, the explanation panel
# says NOT_CONFIGURED, and adding a vehicle from a photo says so plainly.
# Nothing is faked in its absence.
#
# NEVER commit this, and never paste it into a chat transcript or an issue.
ANTHROPIC_API_KEY=""

# Optional model overrides. Vision and reasoning are not necessarily best
# served by the same model, so they are set separately.
# ANTHROPIC_MODEL="claude-sonnet-5"
# RECOGNITION_MODEL="claude-sonnet-5"

# --- Optional provider seams ------------------------------------------------
#
# Each of these selects a registered provider by id. An unknown id falls back
# to unconfigured rather than throwing at request time — a typo here should
# degrade to "nothing is configured", which is true, not take the app down.

# Repair video rendering (Stage 20). No backend is registered in this build.
# VIDEO_PROVIDER=""

# Parts and labour pricing (Stage 23). Without one, every estimate carries the
# reason it is unknown rather than a plausible figure.
# COST_PROVIDER=""

# Mechanic, service centre and parts directory (Stage 28). Without one, nothing
# is listed and the page says why — not that there is nobody near you.
# MARKETPLACE_PROVIDER=""
